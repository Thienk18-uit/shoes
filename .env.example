# Database Configuration
DB_HOST=db
DB_USER=shoestore
DB_PASS=shoestorepass
DB_NAME=shoestore

# MySQL Root
MYSQL_ROOT_PASSWORD=rootpass

# Docker Hub
DOCKER_IMAGE=YOUR_USERNAME/shoes-web:latest

# Render Deployment
RENDER_SERVICE_ID=your_service_id
RENDER_API_KEY=your_api_key

# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=https://shoes-web.onrender.com
